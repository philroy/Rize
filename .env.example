# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Model Configuration (sonnet for speed, opus for depth)
AI_MODEL=claude-sonnet-4-5-20250929

# OpenAI Configuration (for Whisper STT)
OPENAI_API_KEY=your_openai_key_here

# ElevenLabs Configuration (for TTS - optional)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Voice Configuration
VOICE_ENABLED=true
TTS_PROVIDER=system  # Options: elevenlabs, system
STT_PROVIDER=whisper # Options: whisper, system
STT_LANGUAGE=en

# Wake Time Configuration (cron format)
WAKE_TIME=30 7 * * *  # 7:30 AM daily

# User Configuration
USER_NAME=
USER_TIMEZONE=Australia/Sydney

# Autonomy Configuration
AUTONOMY_LEVEL=80  # 0-100, how freely Rize acts on her own
SELF_MODIFICATION_ENABLED=true  # Allow Rize to change her own personality
